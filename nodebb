#!/usr/bin/env node

'use strict';

const fs = require('fs');
const { spawnSync } = require('child_process');

let needsBuild = false;

if (process.env.MONGO_URI && !fs.existsSync('config.json')) {
  fs.writeFileSync('config.json', JSON.stringify({
    url: process.env.NODEBB_URL,
    mongo: { uri: process.env.MONGO_URI },
  }));
  needsBuild = true;
}

if (needsBuild && process.argv[2] === 'start') {
  const build = spawnSync(process.execPath, [__filename, 'build'], { stdio: 'inherit' });
  if (build.status !== 0) {
    process.exit(build.status || 1);
  }
}

require('./src/cli');
