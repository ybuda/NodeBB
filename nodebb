#!/usr/bin/env node

'use strict';

const fs = require('fs');

// Render provides the database connection as an environment variable. Keep
// this generated configuration out of Git while allowing pre-built assets to
// be used on memory-constrained instances.
if (process.env.MONGO_URI && !fs.existsSync('config.json')) {
	fs.writeFileSync('config.json', JSON.stringify({
		url: process.env.NODEBB_URL,
		mongo: { uri: process.env.MONGO_URI },
	}));
}

require('./src/cli');
